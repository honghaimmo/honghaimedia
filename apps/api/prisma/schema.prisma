generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  phone           String?   @unique
  phoneVerified   DateTime?
  passwordHash    String
  fullName        String
  avatarUrl       String?
  role            Role      @default(USER)
  status          UserStatus @default(ACTIVE)

  // VIP
  vipLevel        VipLevel  @default(BRONZE)
  vipPoints       Int       @default(0)
  totalSpent      Decimal   @default(0) @db.Decimal(18, 2)

  // 2FA
  twoFactorSecret String?
  twoFactorEnabled Boolean  @default(false)

  // Affiliate
  referralCode    String    @unique
  referredById    String?
  referredBy      User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]    @relation("Referrals")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet          Wallet?
  sessions        Session[]
  devices         Device[]
  orders          Order[]
  deposits        Deposit[]
  withdraws       Withdraw[]
  tickets         Ticket[]
  vouchersUsed    VoucherUsage[]
  affiliateEarnings AffiliateEarning[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([referralCode])
}

enum Role {
  USER
  SUPPORT
  ORDER_MANAGER
  PRODUCT_MANAGER
  FINANCE
  AUDITOR
  MANAGER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum VipLevel {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  name        String?
  lastIp      String?
  lastSeenAt  DateTime @default(now())
  trusted     Boolean  @default(false)

  @@unique([userId, fingerprint])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
}

// ============================================================
// PRODUCTS & CATEGORIES
// ============================================================

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameEn      String?
  nameZh      String?
  nameKo      String?
  nameJa      String?
  nameTh      String?
  description String?
  iconUrl     String?
  bannerUrl   String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  parentId    String?
  parent      Category? @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
}

model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  shortDesc       String?
  description     String?
  imageUrl        String?
  gallery         String[]  @default([])

  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])

  price           Decimal   @db.Decimal(18, 2)
  salePrice       Decimal?  @db.Decimal(18, 2)
  currency        String    @default("VND")

  // Tồn kho
  stock           Int?       // null = không giới hạn (dịch vụ API)
  minQuantity     Int       @default(1)
  maxQuantity     Int?

  // Provider API
  providerId      String?
  provider        Provider? @relation(fields: [providerId], references: [id])
  providerSku     String?

  // Flags
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  isApiAuto       Boolean   @default(false)   // true = xử lý tự động qua API
  requiresManual  Boolean   @default(true)    // nếu không có API

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orderItems      OrderItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model Provider {
  id           String    @id @default(cuid())
  name         String
  baseUrl      String
  apiKeyEnc    String    // MÃ HÓA, không lưu plain
  apiSecretEnc String?
  webhookSecret String?
  isActive     Boolean   @default(true)
  products     Product[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============================================================
// CART & ORDERS
// ============================================================

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id            String        @id @default(cuid())
  code          String        @unique   // HH2026xxxxx
  userId        String
  user          User          @relation(fields: [userId], references: [id])

  subtotal      Decimal       @db.Decimal(18, 2)
  discount      Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  currency      String        @default("VND")

  voucherId     String?
  voucher       Voucher?      @relation(fields: [voucherId], references: [id])

  status        OrderStatus   @default(PENDING)
  note          String?
  adminNote     String?

  paidAt        DateTime?
  completedAt   DateTime?
  refundedAt    DateTime?

  items         OrderItem[]
  transactions  WalletTransaction[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([code])
}

enum OrderStatus {
  PENDING         // Chờ thanh toán
  PAID            // Đã thanh toán
  PROCESSING      // Đang xử lý
  DELIVERING      // Đang giao
  MANUAL          // Chờ xử lý thủ công
  COMPLETED       // Hoàn thành
  FAILED          // Thất bại
  CANCELLED       // Đã hủy
  REFUNDED        // Đã hoàn tiền
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])

  productName  String   // snapshot
  quantity     Int
  unitPrice    Decimal  @db.Decimal(18, 2)
  totalPrice   Decimal  @db.Decimal(18, 2)

  // Kết quả từ provider
  providerOrderId String?
  deliveryData    Json?     // dữ liệu trả khách (account, key...)
  errorMessage    String?
}

// ============================================================
// WALLET
// ============================================================

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance       Decimal  @default(0) @db.Decimal(18, 2)
  totalDeposit  Decimal  @default(0) @db.Decimal(18, 2)
  totalSpent    Decimal  @default(0) @db.Decimal(18, 2)
  totalRefunded Decimal  @default(0) @db.Decimal(18, 2)

  isLocked      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  transactions  WalletTransaction[]
}

model WalletTransaction {
  id           String   @id @default(cuid())
  code         String   @unique
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id])

  type         TxType
  amount       Decimal  @db.Decimal(18, 2)
  balanceBefore Decimal @db.Decimal(18, 2)
  balanceAfter  Decimal @db.Decimal(18, 2)

  status       TxStatus @default(PENDING)
  description  String?
  refId        String?  // orderId hoặc depositId
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([walletId])
  @@index([status])
}

enum TxType {
  DEPOSIT       // Nạp tiền
  PURCHASE      // Mua hàng
  REFUND        // Hoàn tiền
  WITHDRAW      // Rút tiền
  TRANSFER_IN   // Nhận chuyển khoản nội bộ
  TRANSFER_OUT  // Chuyển khoản nội bộ
  AFFILIATE     // Hoa hồng
  ADMIN_ADJUST  // Admin điều chỉnh
}

enum TxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REVERSED
}

// ============================================================
// DEPOSITS & WITHDRAWS
// ============================================================

model Deposit {
  id            String        @id @default(cuid())
  code          String        @unique        // HHNAPxxxxx
  userId        String
  user          User          @relation(fields: [userId], references: [id])

  amount        Decimal       @db.Decimal(18, 2)
  method        DepositMethod
  status        DepositStatus @default(PENDING)

  // Ngân hàng / cổng
  bankCode      String?
  bankAccount   String?
  bankContent   String?                       // memo chuyển khoản

  // Gateway ref
  gatewayTxId   String?
  gatewayRaw    Json?
  gatewaySig    String?                       // HMAC để verify

  paidAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([status])
  @@index([code])
}

enum DepositMethod {
  BANK_TRANSFER
  VNPAY
  MOMO
  ZALOPAY
}

enum DepositStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REVERSED
}

model Withdraw {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  amount        Decimal  @db.Decimal(18, 2)
  bankName      String
  bankAccount   String
  accountName   String

  status        TxStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  rejectReason  String?

  createdAt     DateTime @default(now())
}

// ============================================================
// VOUCHERS
// ============================================================

model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?

  type          VoucherType
  value         Decimal  @db.Decimal(18, 2)   // % hoặc số tiền
  maxDiscount   Decimal? @db.Decimal(18, 2)
  minOrder      Decimal  @default(0) @db.Decimal(18, 2)

  quantity      Int?       // null = không giới hạn
  usedCount     Int        @default(0)
  perUserLimit  Int        @default(1)

  startAt       DateTime
  endAt         DateTime
  isActive      Boolean    @default(true)

  orders        Order[]
  usages        VoucherUsage[]

  createdAt     DateTime   @default(now())
}

enum VoucherType {
  PERCENT
  FIXED
}

model VoucherUsage {
  id         String   @id @default(cuid())
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String
  usedAt     DateTime @default(now())

  @@unique([voucherId, userId, orderId])
}

// ============================================================
// AFFILIATE
// ============================================================

model AffiliateEarning {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  orderId       String
  orderAmount   Decimal         @db.Decimal(18, 2)
  commission    Decimal         @db.Decimal(18, 2)
  rate          Decimal         @db.Decimal(5, 2)
  status        TxStatus        @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime        @default(now())

  @@index([userId, status])
}

// ============================================================
// TICKETS & SUPPORT
// ============================================================

model Ticket {
  id         String       @id @default(cuid())
  code       String       @unique
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  subject    String
  status     TicketStatus @default(OPEN)
  priority   Int          @default(1)
  messages   TicketMessage[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  isStaff   Boolean  @default(false)
  content   String
  attachments String[] @default([])
  createdAt DateTime @default(now())
}

// ============================================================
// AUDIT & SECURITY
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
}
