# Database
DATABASE_URL="postgresql://user:pass@host:5432/honghai?schema=public"

# Redis
REDIS_URL="redis://default:pass@host:6379"

# App
NODE_ENV=production
API_URL="https://api.honghaimmo.com"
WEB_URL="https://honghaimmo.com"
PORT=4000

# Session
SESSION_SECRET="generate_64_bytes_random_hex"
COOKIE_DOMAIN=".honghaimmo.com"

# JWT (cho API token nếu cần)
JWT_SECRET="another_64_bytes_random_hex"

# Encryption cho provider API keys
ENCRYPTION_KEY="32_bytes_hex_for_aes_256"   # 64 ký tự hex

# Email (Resend/Sendgrid)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="no-reply@honghaimmo.com"

# Payment
SEPAY_WEBHOOK_SECRET="sepay_hmac_secret"
SEPAY_API_KEY="sepay_api_key"
VNPAY_TMN_CODE="xxx"
VNPAY_HASH_SECRET="xxx"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# AI
OPENAI_API_KEY="sk-xxx"

# Frontend
NEXT_PUBLIC_API_URL="https://api.honghaimmo.com"
NEXT_PUBLIC_SITE_NAME="HỒNG HẢI MMO"
